# Shared CMake initial cache. Checked in, not generated by bootstrap.
get_filename_component(_adecc_test_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
get_filename_component(_adecc_buildengine_root "${_adecc_test_root}/.." ABSOLUTE)
set(_adecc_toolchain "${_adecc_buildengine_root}/admin/cmake/toolchains/bcc64x-buildengine-cxx.cmake")
set(_adecc_ninja "${_adecc_buildengine_root}/tools/ninja/1.13.2/ninja.exe")
foreach(_adecc_required IN ITEMS "${_adecc_toolchain}" "${_adecc_ninja}")
  if(NOT EXISTS "${_adecc_required}")
    message(FATAL_ERROR "BuildEngine tool not found: ${_adecc_required}")
  endif()
endforeach()
set(CMAKE_TOOLCHAIN_FILE "${_adecc_toolchain}" CACHE FILEPATH "BuildEngine BCC64X toolchain")
set(CMAKE_MAKE_PROGRAM "${_adecc_ninja}" CACHE FILEPATH "BuildEngine-managed Ninja")
set(BUILDENGINE_ROOT "${_adecc_buildengine_root}" CACHE PATH "BuildEngine workspace")
set(BUILDENGINE_INSTALL_ROOT "${_adecc_buildengine_root}/install" CACHE PATH "BuildEngine install root")
set(CMAKE_CXX_SCAN_FOR_MODULES OFF CACHE BOOL "BCC64X module scanning")
