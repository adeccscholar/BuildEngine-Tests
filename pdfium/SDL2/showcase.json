      "version": "2025.11.19",
      "direct": true
    },
    {
      "library": "sdl2",
      "version": "2.32.10",
      "direct": true
    },
    {
      "library": "abseil",
      "version": "20260817.0",
      "direct": false
    },
    {
      "library": "fast_float",
      "version": "8.3.3",
      "direct": false
    },
    {
      "library": "skia",
      "version": "153",
      "direct": false
    },
    {
      "library": "zlib",
      "version": "1.4",
      "direct": false
    },
    {
      "library": "libjpeg-turbo",
      "version": "3.2.0",
      "direct": false
    },
    {
