cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED ROOT)
   message(FATAL_ERROR "ROOT required")
endif()
set(_projects WeatherClient PolicyTest CompareTest financial geospatial-skia opengl-sdl2-earth
   openmp-galaxy openmp-mandelbrot pdf-image-extraction
   pdfium/Common pdfium/SDL2 pdfium/VCL skia-direct-showcase
   tests/pdf-image-extraction thirdparty-showcase docu-server
   database/mssql database/postgre OpenXlsxGrid)
file(READ "${ROOT}/LICENSE" _polyform)
string(STRIP "${_polyform}" _polyform)
foreach(_project IN LISTS _projects)
   foreach(_file IN ITEMS Description.md build.md LICENSE.md SBOM.md)
      if(NOT EXISTS "${ROOT}/${_project}/${_file}")
         message(FATAL_ERROR "Missing documentation: ${_project}/${_file}")
      endif()
   endforeach()
   file(READ "${ROOT}/${_project}/LICENSE.md" _license)
   string(FIND "${_license}" "${_polyform}" _full_terms)
   if(_full_terms EQUAL -1)
      message(FATAL_ERROR "${_project}: full PolyForm license and required notice missing")
   endif()
   file(GLOB _boms "${ROOT}/${_project}/SBOM-*.cdx.json")
   if(NOT _boms)
      message(FATAL_ERROR "${_project}: missing CycloneDX files")
   endif()
   foreach(_bom IN LISTS _boms)
      file(READ "${_bom}" _json)
      string(JSON _format ERROR_VARIABLE _error GET "${_json}" bomFormat)
      if(_error OR NOT _format STREQUAL "CycloneDX")
         message(FATAL_ERROR "Invalid CycloneDX file: ${_bom}")
      endif()
      string(JSON _version ERROR_VARIABLE _error GET "${_json}" specVersion)
      if(_error OR NOT _version STREQUAL "1.6")
         message(FATAL_ERROR "CycloneDX 1.6 expected: ${_bom}")
      endif()
      string(JSON _license ERROR_VARIABLE _error GET "${_json}" metadata component licenses 0 license name)
      if(_error OR NOT _license STREQUAL "PolyForm Noncommercial License 1.0.0")
         message(FATAL_ERROR "Application license missing in ${_bom}")
      endif()
   endforeach()
endforeach()
foreach(_index IN ITEMS
   database/README.md
   database/common/README.md
   database/common/original/README.md)
   if(NOT EXISTS "${ROOT}/${_index}")
      message(FATAL_ERROR "Missing database documentation: ${_index}")
   endif()
endforeach()
foreach(_backend IN ITEMS mssql postgre)
   if(NOT EXISTS "${ROOT}/database/${_backend}/Configure.md")
      message(FATAL_ERROR "Missing database/${_backend}/Configure.md")
   endif()
endforeach()
message(STATUS "License text and declared CycloneDX SBOMs validated (not a binary compliance audit)")
