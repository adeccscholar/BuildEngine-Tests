{
  "schemaVersion": 1,
  "kind": "extended-test",
  "title": "PostgreSQL Native Query and Transaction Tests",
  "summary": "Validates libpq/libpqxx queries, SSPI authentication, result ranges, transactions and database constraints.",
  "dependencies": [
    {
      "library": "libpq",
      "version": "active",
      "direct": true
    },
    {
      "library": "libpqxx",
      "version": "active",
      "direct": true
    },
    {
      "library": "openssl",
      "version": "active",
      "direct": false
    },
    {
      "library": "zlib",
      "version": "active",
      "direct": false
    },
    {
      "library": "brotli",
      "version": "active",
      "direct": false
    },
    {
      "library": "zstd",
      "version": "active",
      "direct": false
    }
  ],
  "externalDependencies": [
    "PostgreSQL server",
    "adecc-core-lib PostgreSQL interface"
  ],
  "status": "not-verified",
  "applications": [
    {
      "name": "adecc_postgresql_pqxx_test",
      "summary": "Exercises native libpqxx database and transaction operations",
      "command": "..\\build\\Test\\postgre\\Release\\adecc_postgresql_pqxx_test.exe --host localhost --database BuildEngineTest --user buildenginetest_user --integrated",
      "interactive": false
    },
    {
      "name": "adecc_postgresql_additional_test",
      "summary": "Executes shared logical-database checks on PostgreSQL",
      "command": "..\\build\\Test\\postgre\\Release\\adecc_postgresql_additional_test.exe --host localhost --database BuildEngineTest --user buildenginetest_user --integrated",
      "interactive": false
    }
  ]
}
