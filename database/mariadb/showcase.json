{
  "schemaVersion": 1,
  "kind": "extended-test",
  "title": "MariaDB Native Database Integration",
  "summary": "Validates parameter handling, relational constraints, transaction behavior and XML/CSV membership import.",
  "dependencies": [
    {
      "library": "mariadb-connector-c",
      "version": "active",
      "direct": true
    },
    {
      "library": "zlib",
      "version": "active",
      "direct": false
    },
    {
      "library": "zstd",
      "version": "active",
      "direct": false
    },
    {
      "library": "pugixml",
      "version": "active",
      "direct": true
    }
  ],
  "externalDependencies": [
    "MariaDB server",
    "adecc-core-lib database interface"
  ],
  "status": "not-verified",
  "applications": [
    {
      "name": "adecc_mariadb_logical_test",
      "summary": "Exercises MariaDB logical queries and transactions",
      "command": "..\\build\\Test\\database\\mariadb\\Release\\adecc_mariadb_logical_test.exe --database BuildEngineTest --user root",
      "interactive": false
    },
    {
      "name": "adecc_mariadb_connection_test",
      "summary": "Validates MariaDB connections and authentication",
      "command": "ctest --test-dir ../build/Test/database/mariadb/Release/cmake --output-on-failure",
      "interactive": false
    },
    {
      "name": "adecc_mariadb_member_pipeline",
      "summary": "Exercises member-import pipeline against isolated MariaDB",
      "command": "ctest --test-dir ../build/Test/database/mariadb/Release/cmake --output-on-failure",
      "interactive": false
    }
  ]
}
