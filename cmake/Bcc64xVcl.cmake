# BCC64X / VCL target helpers.
# Target-local VCL behavior plus generated application resources.

include(CMakeParseArguments)

function(cb_set_embt_vcl_target theTarget)
   if(NOT TARGET "${theTarget}")
      message(FATAL_ERROR "cb_set_embt_vcl_target: target '${theTarget}' does not exist")
   endif()

   target_compile_definitions("${theTarget}" PRIVATE UNICODE _UNICODE)
   target_compile_options("${theTarget}" PRIVATE -tV -tU)
   target_link_options("${theTarget}" PRIVATE -tV -tU)
endfunction()

# Register a standard C++Builder VCL form unit with CMake.
# The DFM integration is performed by BCC64X through
#   #pragma resource "*.dfm"
# in the owning .cpp unit. CMake tracks the .dfm so Ninja rebuilds the
# corresponding object whenever the Designer file changes.
function(cb_add_vcl_form theTarget theCpp theDfm)
   if(NOT TARGET "${theTarget}")
      message(FATAL_ERROR "cb_add_vcl_form: target '${theTarget}' does not exist")
   endif()

   get_filename_component(theCppAbs "${theCpp}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
   get_filename_component(theDfmAbs "${theDfm}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")

   if(NOT EXISTS "${theCppAbs}")
      message(FATAL_ERROR "cb_add_vcl_form: C++ unit not found: ${theCppAbs}")
   endif()
   if(NOT EXISTS "${theDfmAbs}")
      message(FATAL_ERROR "cb_add_vcl_form: DFM not found: ${theDfmAbs}")
   endif()

   set_source_files_properties("${theDfmAbs}" PROPERTIES HEADER_FILE_ONLY TRUE)
   set_property(SOURCE "${theCppAbs}" APPEND PROPERTY OBJECT_DEPENDS "${theDfmAbs}")
   target_sources("${theTarget}" PRIVATE "${theDfmAbs}")
endfunction()

# Generate the Windows application resource at configure time.
# Source of truth is CMake metadata + original assets. The .rc file is written
# only to the build tree and is compiled by CMake's RC language (Windows SDK rc.exe).
#
# Example:
# cb_add_windows_application_resources(MyApp
#    ICON "${CMAKE_CURRENT_SOURCE_DIR}/app.ico"
#    FILE_VERSION 1 2 3 4
#    PRODUCT_VERSION 1 2 3 4
#    COMPANY_NAME "Example GmbH"
#    FILE_DESCRIPTION "Example application"
#    INTERNAL_NAME "MyApp"
#    ORIGINAL_FILENAME "MyApp.exe"
#    PRODUCT_NAME "Example Product"
#    COPYRIGHT "Copyright (C) 2026 Example GmbH")
function(cb_add_windows_application_resources theTarget)
   if(NOT TARGET "${theTarget}")
      message(FATAL_ERROR "cb_add_windows_application_resources: target '${theTarget}' does not exist")
   endif()

   set(options)
   set(oneValueArgs ICON COMPANY_NAME FILE_DESCRIPTION INTERNAL_NAME ORIGINAL_FILENAME PRODUCT_NAME COPYRIGHT)
   set(multiValueArgs FILE_VERSION PRODUCT_VERSION)
   cmake_parse_arguments(CBRES "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

   if(NOT CBRES_FILE_VERSION)
      set(CBRES_FILE_VERSION 1 0 0 0)
   endif()
   if(NOT CBRES_PRODUCT_VERSION)
      set(CBRES_PRODUCT_VERSION ${CBRES_FILE_VERSION})
   endif()

   list(LENGTH CBRES_FILE_VERSION theFileVersionCount)
   list(LENGTH CBRES_PRODUCT_VERSION theProductVersionCount)
   if(NOT theFileVersionCount EQUAL 4)
      message(FATAL_ERROR "FILE_VERSION requires exactly four numeric components")
   endif()
   if(NOT theProductVersionCount EQUAL 4)
      message(FATAL_ERROR "PRODUCT_VERSION requires exactly four numeric components")
   endif()

   list(JOIN CBRES_FILE_VERSION "," theFileVersionComma)
   list(JOIN CBRES_PRODUCT_VERSION "," theProductVersionComma)
   list(JOIN CBRES_FILE_VERSION "." theFileVersionText)
   list(JOIN CBRES_PRODUCT_VERSION "." theProductVersionText)

   if(NOT CBRES_COMPANY_NAME)
      set(CBRES_COMPANY_NAME "")
   endif()
   if(NOT CBRES_FILE_DESCRIPTION)
      set(CBRES_FILE_DESCRIPTION "${theTarget}")
   endif()
   if(NOT CBRES_INTERNAL_NAME)
      set(CBRES_INTERNAL_NAME "${theTarget}")
   endif()
   if(NOT CBRES_ORIGINAL_FILENAME)
      set(CBRES_ORIGINAL_FILENAME "${theTarget}.exe")
   endif()
   if(NOT CBRES_PRODUCT_NAME)
      set(CBRES_PRODUCT_NAME "${theTarget}")
   endif()
   if(NOT CBRES_COPYRIGHT)
      set(CBRES_COPYRIGHT "")
   endif()

   set(theGeneratedDir "${CMAKE_CURRENT_BINARY_DIR}/generated")
   file(MAKE_DIRECTORY "${theGeneratedDir}")
   set(theRcFile "${theGeneratedDir}/${theTarget}_resource.rc")

   set(theIconLine "")
   if(CBRES_ICON)
      get_filename_component(theIconAbs "${CBRES_ICON}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
      if(NOT EXISTS "${theIconAbs}")
         message(FATAL_ERROR "Application icon not found: ${theIconAbs}")
      endif()
      file(TO_CMAKE_PATH "${theIconAbs}" theIconRcPath)
      set(theIconLine "1 ICON \"${theIconRcPath}\"\n")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${theIconAbs}")
   endif()

   file(WRITE "${theRcFile}" "// Generated by Bcc64xVcl.cmake. Do not edit.\n")
   file(APPEND "${theRcFile}" "#include <windows.h>\n\n")
   file(APPEND "${theRcFile}" "${theIconLine}\n")
   file(APPEND "${theRcFile}" "1 VERSIONINFO\n")
   file(APPEND "${theRcFile}" " FILEVERSION ${theFileVersionComma}\n")
   file(APPEND "${theRcFile}" " PRODUCTVERSION ${theProductVersionComma}\n")
   file(APPEND "${theRcFile}" " FILEFLAGSMASK 0x3fL\n")
   file(APPEND "${theRcFile}" " FILEFLAGS 0x0L\n")
   file(APPEND "${theRcFile}" " FILEOS 0x40004L\n")
   file(APPEND "${theRcFile}" " FILETYPE 0x1L\n")
   file(APPEND "${theRcFile}" " FILESUBTYPE 0x0L\n")
   file(APPEND "${theRcFile}" "BEGIN\n")
   file(APPEND "${theRcFile}" "  BLOCK \"StringFileInfo\"\n")
   file(APPEND "${theRcFile}" "  BEGIN\n")
   file(APPEND "${theRcFile}" "    BLOCK \"040704E4\"\n")
   file(APPEND "${theRcFile}" "    BEGIN\n")
   file(APPEND "${theRcFile}" "      VALUE \"CompanyName\", \"${CBRES_COMPANY_NAME}\\0\"\n")
   file(APPEND "${theRcFile}" "      VALUE \"FileDescription\", \"${CBRES_FILE_DESCRIPTION}\\0\"\n")
   file(APPEND "${theRcFile}" "      VALUE \"FileVersion\", \"${theFileVersionText}\\0\"\n")
   file(APPEND "${theRcFile}" "      VALUE \"InternalName\", \"${CBRES_INTERNAL_NAME}\\0\"\n")
   file(APPEND "${theRcFile}" "      VALUE \"LegalCopyright\", \"${CBRES_COPYRIGHT}\\0\"\n")
   file(APPEND "${theRcFile}" "      VALUE \"OriginalFilename\", \"${CBRES_ORIGINAL_FILENAME}\\0\"\n")
   file(APPEND "${theRcFile}" "      VALUE \"ProductName\", \"${CBRES_PRODUCT_NAME}\\0\"\n")
   file(APPEND "${theRcFile}" "      VALUE \"ProductVersion\", \"${theProductVersionText}\\0\"\n")
   file(APPEND "${theRcFile}" "    END\n")
   file(APPEND "${theRcFile}" "  END\n")
   file(APPEND "${theRcFile}" "  BLOCK \"VarFileInfo\"\n")
   file(APPEND "${theRcFile}" "  BEGIN\n")
   file(APPEND "${theRcFile}" "    VALUE \"Translation\", 0x0407, 1252\n")
   file(APPEND "${theRcFile}" "  END\n")
   file(APPEND "${theRcFile}" "END\n")

   set_source_files_properties("${theRcFile}" PROPERTIES GENERATED TRUE)
   target_sources("${theTarget}" PRIVATE "${theRcFile}")

   message(STATUS "Generated application resources: ${theRcFile}")
endfunction()