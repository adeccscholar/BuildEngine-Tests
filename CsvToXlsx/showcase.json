{
  "schemaVersion": 1,
  "kind": "extended-test",
  "title": "CSV to Excel Conversion and Roundtrip",
  "summary": "Converts quoted UTF-8 CSV data with heterogeneous field widths to XLSX and verifies an exact data roundtrip.",
  "dependencies": [
    {
      "library": "openxlsx",
      "version": "active",
      "direct": true
    },
    {
      "library": "pugixml",
      "version": "active",
      "direct": false
    },
    {
      "library": "libzip",
      "version": "active",
      "direct": false
    },
    {
      "library": "boost",
      "version": "active",
      "direct": false
    },
    {
      "library": "zlib",
      "version": "active",
      "direct": false
    },
    {
      "library": "xz",
      "version": "active",
      "direct": false
    },
    {
      "library": "zstd",
      "version": "active",
      "direct": false
    },
    {
      "library": "openssl",
      "version": "active",
      "direct": false
    },
    {
      "library": "brotli",
      "version": "active",
      "direct": false
    }
  ],
  "externalDependencies": [],
  "status": "not-verified",
  "applications": [
    {
      "name": "adecc_csv_to_xlsx",
      "summary": "Converts CSV files to XLSX with optional input/output directory selection",
      "command": "..\\build\\Test\\CsvToXlsx\\Release\\adecc_csv_to_xlsx.exe \"D:\\Data\\Input\"",
      "interactive": false
    },
    {
      "name": "adecc_csv_to_xlsx_test",
      "summary": "Validates CSV parser and XLSX conversion edge cases",
      "command": "ctest --test-dir ../build/Test/CsvToXlsx/Release/cmake --output-on-failure",
      "interactive": false
    }
  ]
}
