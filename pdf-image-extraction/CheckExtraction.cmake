cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED TEST_EXE OR NOT DEFINED TEST_PDF OR NOT DEFINED TEST_OUTPUT)
  message(FATAL_ERROR "TEST_EXE, TEST_PDF and TEST_OUTPUT are required")
endif()
file(REMOVE_RECURSE "${TEST_OUTPUT}")
execute_process(
  COMMAND "${TEST_EXE}" "${TEST_PDF}" "${TEST_OUTPUT}"
  RESULT_VARIABLE result
  OUTPUT_VARIABLE output
  ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "QPDF extraction failed (${result}):\n${output}\n${error}")
endif()
if(NOT output MATCHES "RESULT\\|images=1\\|unique=1\\|")
  message(FATAL_ERROR "Unexpected extraction report:\n${output}")
endif()
if(NOT EXISTS "${TEST_OUTPUT}/images.tsv")
  message(FATAL_ERROR "images.tsv was not produced")
endif()
if(NOT EXISTS "${TEST_OUTPUT}/image-4_0.bin")
  message(FATAL_ERROR "Expected raw one-pixel image not exported")
endif()
file(SIZE "${TEST_OUTPUT}/image-4_0.bin" image_size)
if(NOT image_size EQUAL 1)
  message(FATAL_ERROR "Exported image size differs: ${image_size}")
endif()
file(READ "${TEST_OUTPUT}/images.tsv" manifest)
if(NOT manifest MATCHES "image-4_0\\.bin")
  message(FATAL_ERROR "Manifest does not list the expected image")
endif()
message(STATUS "QPDF single-image extraction PASS")
