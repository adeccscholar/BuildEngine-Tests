# Remove only historical OpenSSL DLLs verified byte-for-byte against
# the previous BuildEngine package, before ordinary strict runtime staging.
foreach(_required IN ITEMS ADECC_DEMO_DIR ADECC_OLD_OPENSSL_ROOT
   ADECC_ACTIVE_OPENSSL_ROOT ADECC_RUNTIME_CONFIG)
   if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
      message(FATAL_ERROR "Missing retired-runtime parameter: ${_required}")
   endif()
endforeach()
set(_old_dir "${ADECC_OLD_OPENSSL_ROOT}/bin/win64/${ADECC_RUNTIME_CONFIG}")
set(_new_dir "${ADECC_ACTIVE_OPENSSL_ROOT}/bin/win64/${ADECC_RUNTIME_CONFIG}")
if(NOT IS_DIRECTORY "${_old_dir}" OR NOT IS_DIRECTORY "${_new_dir}")
   message(STATUS "[RUNTIME] no former/current OpenSSL package pair available for cleanup")
   return()
endif()
file(GLOB _old_dlls LIST_DIRECTORIES FALSE "${_old_dir}/*.dll")
foreach(_old IN LISTS _old_dlls)
   get_filename_component(_name "${_old}" NAME)
   set(_new "${_new_dir}/${_name}")
   set(_installed "${ADECC_DEMO_DIR}/${_name}")
   if(NOT EXISTS "${_new}" OR NOT EXISTS "${_installed}")
      continue()
   endif()
   file(SHA256 "${_old}" _old_hash)
   file(SHA256 "${_new}" _new_hash)
   file(SHA256 "${_installed}" _installed_hash)
   if(_installed_hash STREQUAL _new_hash)
      continue()
   endif()
   if(_installed_hash STREQUAL _old_hash)
      file(REMOVE "${_installed}")
      if(EXISTS "${_installed}")
         message(FATAL_ERROR "Cannot remove verified retired DLL: ${_installed}")
      endif()
      message(STATUS "[RUNTIME] removed verified retired OpenSSL DLL: ${_name}")
   else()
      message(FATAL_ERROR
         "Unexpected DLL at ${_installed}; neither previous nor active BuildEngine OpenSSL hash matches")
   endif()
endforeach()
